/// create Place
POST http://localhost:5000/place
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjY4Mzg0ZDllNTQ5OTJiMzExZmZhZGYzYSIsImlhdCI6MTc0OTk4NzI3OCwiZXhwIjoxNzU3NzYzMjc4fQ.ecGvJyVTkrIXRPIK1uI0gku4iP6R256-C01c4NXjQKY

{
  "name": "Pyramids of Giza",
  "city": "Giza",
  "description": "The last remaining wonder of the ancient world.",
  "images": [
    "https://example.com/pyramids1.jpg",
    "https://example.com/pyramids2.jpg"
  ],
  "category": "Historical",
  "price": 100,
  "location": {
    "type": "Point",
    "coordinates": [31.1342, 29.9792]
  }
}

